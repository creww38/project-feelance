// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum RoleType {
  ADMIN
  KEPALA_SEKOLAH
  GURU
  STAFF_TU
  SISWA
  ORANG_TUA
  GUEST
}

enum JenisKelamin {
  L
  P
}

enum StatusPPDB {
  DRAFT
  SUBMITTED
  VERIFIED
  ACCEPTED
  REJECTED
}

enum StatusAbsensi {
  HADIR
  SAKIT
  IZIN
  ALPHA
  TERLAMBAT
}

enum Hari {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
}

enum StatusPeminjaman {
  DIPINJAM
  DIKEMBALIKAN
  TERLAMBAT
  HILANG
}

enum StatusNotifikasi {
  UNREAD
  READ
}

enum TipeGaleri {
  FOTO
  VIDEO
}

enum StatusBerita {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ============================================
// CORE MODELS
// ============================================

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  username      String       @unique
  password      String
  namaLengkap   String
  foto          String?
  noTelp        String?
  alamat        String?
  jenisKelamin  JenisKelamin?
  tempatLahir   String?
  tanggalLahir  DateTime?
  isActive      Boolean      @default(true)
  lastLogin     DateTime?
  refreshToken  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  userRoles     UserRole[]
  guru          Guru?
  siswa         Siswa?
  orangTua      OrangTua?
  
  berita        Berita[]
  komentar      Komentar[]
  pengumuman    Pengumuman[]
  agenda        Agenda[]
  pesanDikirim  Pesan[]      @relation("PesanPengirim")
  pesanDiterima Pesan[]      @relation("PesanPenerima")
  notifikasi    Notifikasi[]
  logAktivitas  LogAktivitas[]
  peminjaman    Peminjaman[]

  @@index([email])
  @@index([username])
  @@index([namaLengkap])
  @@map("users")
}

model Role {
  id              String            @id @default(cuid())
  nama            RoleType          @unique
  deskripsi       String?
  
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("roles")
}

model Permission {
  id              String            @id @default(cuid())
  nama            String            @unique
  resource        String
  action          String            // CREATE, READ, UPDATE, DELETE, MANAGE
  
  rolePermissions RolePermission[]
  
  createdAt       DateTime          @default(now())

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  @@unique([userId, roleId])
  @@map("user_roles")
}

// ============================================
// MASTER DATA
// ============================================

model Guru {
  id            String           @id @default(cuid())
  userId        String           @unique
  nip           String           @unique
  nuptk         String?
  gelarDepan    String?
  gelarBelakang String?
  spesialisasi  String?
  pendidikan    String?
  jabatan       String?
  statusPegawai String?          // PNS, HONORER, KONTRAK
  
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  waliKelas     Kelas[]
  jadwal        Jadwal[]
  materi        Materi[]
  tugas         Tugas[]
  mataPelajaran MataPelajaran[]
  
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("guru")
}

model Siswa {
  id              String      @id @default(cuid())
  userId          String      @unique
  nis             String      @unique
  nisn            String      @unique
  nik             String?
  noKK            String?
  kelasId         String
  tahunMasuk      Int
  status          String      @default("AKTIF") // AKTIF, LULUS, PINDAH, KELUAR
  
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kelas           Kelas       @relation(fields: [kelasId], references: [id])
  
  orangTua        OrangTua?
  absensi         Absensi[]
  nilai           Nilai[]
  jawabanTugas    JawabanTugas[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("siswa")
}

model OrangTua {
  id          String    @id @default(cuid())
  userId      String    @unique
  siswaId     String    @unique
  hubungan    String    // AYAH, IBU, WALI
  pekerjaan   String?
  pendapatan  String?
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  siswa       Siswa     @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("orang_tua")
}

model Jurusan {
  id          String    @id @default(cuid())
  kode        String    @unique
  nama        String
  deskripsi   String?
  akreditasi  String?
  kapasitas   Int?
  
  kelas       Kelas[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("jurusan")
}

model Kelas {
  id            String       @id @default(cuid())
  nama          String
  tingkat       Int
  jurusanId     String
  tahunAjaranId String
  waliKelasId   String?
  kapasitas     Int          @default(30)
  
  jurusan       Jurusan      @relation(fields: [jurusanId], references: [id])
  tahunAjaran   TahunAjaran  @relation(fields: [tahunAjaranId], references: [id])
  waliKelas     Guru?        @relation(fields: [waliKelasId], references: [id])
  
  siswa         Siswa[]
  jadwal        Jadwal[]
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("kelas")
}

model MataPelajaran {
  id          String    @id @default(cuid())
  kode        String    @unique
  nama        String
  deskripsi   String?
  kkm         Int       @default(75)
  semester    Int?
  tingkat     Int?
  
  guruId      String?
  guru        Guru?     @relation(fields: [guruId], references: [id])
  
  jadwal      Jadwal[]
  materi      Materi[]
  tugas       Tugas[]
  nilai       Nilai[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("mata_pelajaran")
}

model TahunAjaran {
  id              String       @id @default(cuid())
  nama            String
  tanggalMulai    DateTime
  tanggalSelesai  DateTime
  isActive        Boolean      @default(false)
  semester        String       @default("GANJIL") // GANJIL, GENAP
  
  kelas           Kelas[]
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("tahun_ajaran")
}

model Jadwal {
  id                String         @id @default(cuid())
  kelasId           String
  mataPelajaranId   String
  guruId            String
  hari              Hari
  jamMulai          String
  jamSelesai        String
  ruangan           String?
  
  kelas             Kelas          @relation(fields: [kelasId], references: [id])
  mataPelajaran     MataPelajaran  @relation(fields: [mataPelajaranId], references: [id])
  guru              Guru           @relation(fields: [guruId], references: [id])
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("jadwal")
}

// ============================================
// CONTENT MANAGEMENT
// ============================================

model Berita {
  id          String        @id @default(cuid())
  judul       String
  slug        String        @unique
  konten      String        @db.Text
  ringkasan   String?
  gambar      String?
  status      StatusBerita  @default(DRAFT)
  isFeatured  Boolean       @default(false)
  viewedCount Int           @default(0)
  
  authorId    String
  kategoriId  String
  
  author      User          @relation(fields: [authorId], references: [id])
  kategori    Kategori      @relation(fields: [kategoriId], references: [id])
  
  tags        BeritaTag[]
  komentar    Komentar[]
  likes       BeritaLike[]
  
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([slug])
  @@index([status])
  @@index([kategoriId])
  @@index([publishedAt])
  @@map("berita")
}

model Kategori {
  id          String    @id @default(cuid())
  nama        String    @unique
  slug        String    @unique
  deskripsi   String?
  warna       String?
  icon        String?
  
  berita      Berita[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("kategori")
}

model Tag {
  id          String      @id @default(cuid())
  nama        String      @unique
  slug        String      @unique
  
  berita      BeritaTag[]
  
  createdAt   DateTime    @default(now())

  @@map("tags")
}

model BeritaTag {
  id        String  @id @default(cuid())
  beritaId  String
  tagId     String
  
  berita    Berita  @relation(fields: [beritaId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@unique([beritaId, tagId])
  @@map("berita_tags")
}

model Komentar {
  id        String     @id @default(cuid())
  konten    String     @db.Text
  beritaId  String
  userId    String
  parentId  String?
  isApproved Boolean   @default(true)
  
  berita    Berita     @relation(fields: [beritaId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Komentar?  @relation("KomentarReplies", fields: [parentId], references: [id])
  replies   Komentar[] @relation("KomentarReplies")
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("komentar")
}

model BeritaLike {
  id        String   @id @default(cuid())
  beritaId  String
  userId    String
  
  berita    Berita   @relation(fields: [beritaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([beritaId, userId])
  @@map("berita_likes")
}

// ============================================
// GALERI
// ============================================

model Album {
  id          String    @id @default(cuid())
  nama        String
  slug        String    @unique
  deskripsi   String?
  cover       String?
  isPublished Boolean   @default(false)
  
  galeri      Galeri[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("album")
}

model Galeri {
  id          String     @id @default(cuid())
  judul       String
  deskripsi   String?
  tipe        TipeGaleri
  url         String
  thumbnail   String?
  ukuran      Int?
  width       Int?
  height      Int?
  
  albumId     String
  album       Album      @relation(fields: [albumId], references: [id], onDelete: Cascade)
  
  uploadedBy  String
  uploader    User       @relation(fields: [uploadedBy], references: [id])
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("galeri")
}

// ============================================
// PENGUMUMAN & AGENDA
// ============================================

model Pengumuman {
  id          String    @id @default(cuid())
  judul       String
  konten      String    @db.Text
  isPinned    Boolean   @default(false)
  priority    Int       @default(0)
  lampiran    String?
  status      String    @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  
  publishedAt DateTime?
  expiredAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("pengumuman")
}

model Agenda {
  id              String   @id @default(cuid())
  judul           String
  deskripsi       String?
  lokasi          String?
  tanggalMulai    DateTime
  tanggalSelesai  DateTime
  waktuMulai      String?
  waktuSelesai    String?
  isAllDay        Boolean  @default(false)
  reminder        Boolean  @default(false)
  reminderTime    Int?     // menit sebelum acara
  
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("agenda")
}

// ============================================
// PPDB
// ============================================

model PPDB {
  id              String       @id @default(cuid())
  noPendaftaran   String       @unique
  namaLengkap     String
  nisn            String?
  nik             String?
  jenisKelamin    JenisKelamin
  tempatLahir     String
  tanggalLahir    DateTime
  alamat          String
  noTelp          String
  email           String?
  asalSekolah     String?
  namaOrtu        String
  noTelpOrtu      String
  jurusanId       String
  tahunAjaranId   String
  status          StatusPPDB   @default(DRAFT)
  catatan         String?
  
  jurusan         Jurusan      @relation(fields: [jurusanId], references: [id])
  tahunAjaran     TahunAjaran  @relation(fields: [tahunAjaranId], references: [id])
  
  berkas          PPDBBerkas[]
  
  verifiedBy      String?
  verifier        User?        @relation("PPDBVerifier", fields: [verifiedBy], references: [id])
  verifiedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("ppdb")
}

model PPDBBerkas {
  id          String    @id @default(cuid())
  ppdbId      String
  nama        String
  jenis       String    // IJAZAH, SKHUN, KK, AKTE, FOTO
  url         String
  isVerified  Boolean   @default(false)
  catatan     String?
  
  ppdb        PPDB      @relation(fields: [ppdbId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())

  @@map("ppdb_berkas")
}

// ============================================
// ABSENSI
// ============================================

model Absensi {
  id          String        @id @default(cuid())
  siswaId     String
  tanggal     DateTime      @default(now())
  status      StatusAbsensi
  keterangan  String?
  qrCode      String?       // untuk absensi QR
  lat         Float?        // latitude
  lng         Float?        // longitude
  foto        String?       // foto absensi
  
  siswa       Siswa         @relation(fields: [siswaId], references: [id])
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([siswaId, tanggal])
  @@map("absensi")
}

// ============================================
// E-LEARNING
// ============================================

model Materi {
  id                String         @id @default(cuid())
  judul             String
  deskripsi         String?
  konten            String?        @db.Text
  fileUrl           String?
  videoUrl          String?
  tipeFile          String?
  
  mataPelajaranId   String
  guruId            String
  kelasId           String?
  
  mataPelajaran     MataPelajaran  @relation(fields: [mataPelajaranId], references: [id])
  guru              Guru           @relation(fields: [guruId], references: [id])
  kelas             Kelas?         @relation(fields: [kelasId], references: [id])
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("materi")
}

model Tugas {
  id                String         @id @default(cuid())
  judul             String
  deskripsi         String         @db.Text
  deadline          DateTime
  fileUrl           String?
  tipe              String         @default("TUGAS") // TUGAS, PROYEK, UJIAN
  bobot             Int            @default(100)
  
  mataPelajaranId   String
  guruId            String
  kelasId           String?
  
  mataPelajaran     MataPelajaran  @relation(fields: [mataPelajaranId], references: [id])
  guru              Guru           @relation(fields: [guruId], references: [id])
  kelas             Kelas?         @relation(fields: [kelasId], references: [id])
  
  jawaban           JawabanTugas[]
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("tugas")
}

model JawabanTugas {
  id          String    @id @default(cuid())
  tugasId     String
  siswaId     String
  konten      String?   @db.Text
  fileUrl     String?
  nilai       Float?
  komentar    String?
  status      String    @default("SUBMITTED") // DRAFT, SUBMITTED, GRADED
  
  tugas       Tugas     @relation(fields: [tugasId], references: [id], onDelete: Cascade)
  siswa       Siswa     @relation(fields: [siswaId], references: [id])
  
  submittedAt DateTime  @default(now())
  gradedAt    DateTime?

  @@unique([tugasId, siswaId])
  @@map("jawaban_tugas")
}

model Nilai {
  id                String         @id @default(cuid())
  siswaId           String
  mataPelajaranId   String
  semester          Int
  nilaiTugas        Float?
  nilaiUTS          Float?
  nilaiUAS          Float?
  nilaiAkhir        Float?
  grade             String?
  predikat          String?
  
  siswa             Siswa          @relation(fields: [siswaId], references: [id])
  mataPelajaran     MataPelajaran  @relation(fields: [mataPelajaranId], references: [id])
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([siswaId, mataPelajaranId, semester])
  @@map("nilai")
}

// ============================================
// PERPUSTAKAAN
// ============================================

model Buku {
  id          String       @id @default(cuid())
  kode        String       @unique
  isbn        String?
  judul       String
  pengarang   String
  penerbit    String?
  tahun       Int?
  edisi       String?
  kategori    String?
  deskripsi   String?
  cover       String?
  jumlah      Int          @default(1)
  tersedia    Int          @default(1)
  lokasi      String?
  rak         String?
  
  peminjaman  Peminjaman[]
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("buku")
}

model Peminjaman {
  id                String           @id @default(cuid())
  bukuId            String
  userId            String
  kodePinjam        String           @unique
  tanggalPinjam     DateTime         @default(now())
  tanggalKembali    DateTime?
  batasKembali      DateTime
  status            StatusPeminjaman @default(DIPINJAM)
  denda             Float            @default(0)
  catatan           String?
  
  buku              Buku             @relation(fields: [bukuId], references: [id])
  user              User             @relation(fields: [userId], references: [id])
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("peminjaman")
}

// ============================================
// ALUMNI
// ============================================

model Alumni {
  id              String   @id @default(cuid())
  siswaId         String   @unique
  tahunLulus      Int
  jurusan         String?
  pekerjaan       String?
  namaPerusahaan  String?
  universitas     String?
  jurusanKuliah   String?
  kontak          String?
  email           String?
  alamat          String?
  
  siswa           Siswa    @relation(fields: [siswaId], references: [id])
  
  tracerStudy     TracerStudy[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("alumni")
}

model TracerStudy {
  id              String   @id @default(cuid())
  alumniId        String
  tahun           Int
  status          String   // BEKERJA, KULIAH, WIRAUSAHA, BELUM_BEKERJA
  detail          String?
  gaji            String?
  relevansi       String?
  
  alumni          Alumni   @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())

  @@map("tracer_study")
}

// ============================================
// KOMUNIKASI
// ============================================

model Pesan {
  id          String    @id @default(cuid())
  pengirimId  String
  penerimaId  String
  konten      String    @db.Text
  lampiran    String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  
  pengirim    User      @relation("PesanPengirim", fields: [pengirimId], references: [id])
  penerima    User      @relation("PesanPenerima", fields: [penerimaId], references: [id])
  
  createdAt   DateTime  @default(now())

  @@index([pengirimId, penerimaId])
  @@map("pesan")
}

model Notifikasi {
  id          String            @id @default(cuid())
  userId      String
  judul       String
  konten      String
  tipe        String?           // INFO, WARNING, SUCCESS, ERROR
  link        String?
  status      StatusNotifikasi  @default(UNREAD)
  
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime          @default(now())
  readAt      DateTime?

  @@index([userId, status])
  @@map("notifikasi")
}

// ============================================
// SETTINGS & LOGS
// ============================================

model Setting {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String    @db.Text
  deskripsi   String?
  tipe        String    @default("text") // text, number, boolean, json, file
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("settings")
}

model LogAktivitas {
  id          String    @id @default(cuid())
  userId      String
  aksi        String
  deskripsi   String?
  resource    String?
  resourceId  String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  
  user        User      @relation(fields: [userId], references: [id])
  
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([aksi])
  @@index([createdAt])
  @@map("log_aktivitas")
}